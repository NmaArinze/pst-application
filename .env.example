# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Frontend (exposed to the browser, VITE_ prefix required by Vite) ---
VITE_CONVEX_URL=

# --- Convex backend environment variables ---
# Set these via `npx convex env set <NAME> <value>`, not in this file —
# they are backend secrets and must never reach the browser bundle.
# RESEND_API_KEY=
# SESSION_SECRET=
# PST_SENDING_DOMAIN=
# PST_TRACKING_DOMAIN=